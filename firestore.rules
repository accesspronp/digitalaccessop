rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      // Visitors can read only approved reviews
      allow read: if resource.data.approved == true;
      // Visitors can submit a review, but it must start unapproved
      allow create: if request.resource.data.approved == false
        && request.resource.data.keys().hasOnly(['productKey','name','rating','text','approved','createdMs'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      // Only you can approve or delete reviews (in the Firebase console)
      allow update, delete: if false;
    }
  }
}
